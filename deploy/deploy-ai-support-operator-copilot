#!/usr/bin/env bash
# Installed as /usr/local/sbin/deploy-ai-support-operator-copilot.
set -euo pipefail

readonly RUNTIME_DIR=/opt/ai-support-operator-copilot
readonly COMPOSE="$RUNTIME_DIR/docker-compose.production.yml"
readonly ENV_FILE="$RUNTIME_DIR/.env"
readonly SERVICE=api
readonly REPOSITORY='laser54/ai-support-operator-copilot'
readonly ALLOWED_PREFIX='deploy '

command=${SSH_ORIGINAL_COMMAND:-}
if [[ $command != ${ALLOWED_PREFIX}* ]]; then
  echo 'Only deploy <git-sha> is allowed.' >&2
  exit 64
fi

sha=${command#"$ALLOWED_PREFIX"}
if [[ ! $sha =~ ^[0-9a-f]{40}$ ]]; then
  echo 'Deployment revision must be a full lowercase SHA-1.' >&2
  exit 64
fi

registry_token=$(cat)
if [[ -z $registry_token ]]; then
  echo 'Missing registry token.' >&2
  exit 65
fi

cleanup() {
  docker logout ghcr.io >/dev/null 2>&1 || true
}
trap cleanup EXIT

printf '%s' "$registry_token" | docker login ghcr.io -u laser54 --password-stdin >/dev/null

compose_url="https://api.github.com/repos/$REPOSITORY/contents/deploy/docker-compose.production.yml?ref=$sha"
tmp_compose=$(mktemp "$RUNTIME_DIR/docker-compose.production.yml.XXXXXX")
trap 'rm -f "$tmp_compose"; cleanup' EXIT
curl --fail --silent --show-error --location --max-time 30 \
  -H "Authorization: Bearer $registry_token" \
  -H 'Accept: application/vnd.github.raw+json' \
  "$compose_url" -o "$tmp_compose"
IMAGE_TAG="$sha" docker compose --env-file "$ENV_FILE" -f "$tmp_compose" config --quiet
install -m 600 "$tmp_compose" "$COMPOSE"

IMAGE_TAG="$sha" docker compose --env-file "$ENV_FILE" -f "$COMPOSE" pull "$SERVICE"
IMAGE_TAG="$sha" docker compose --env-file "$ENV_FILE" -f "$COMPOSE" up -d --no-build --force-recreate "$SERVICE"

container=$(IMAGE_TAG="$sha" docker compose --env-file "$ENV_FILE" -f "$COMPOSE" ps -q "$SERVICE")
for _ in $(seq 1 18); do
  health=$(docker inspect --format '{{.State.Health.Status}}' "$container")
  if [[ $health == healthy ]]; then
    echo "deployed_sha=$sha"
    echo "container=$container health=healthy"
    exit 0
  fi
  if [[ $health == unhealthy ]]; then
    docker logs --tail 80 "$container" >&2
    exit 1
  fi
  sleep 5
done

echo 'Timed out waiting for the container health check.' >&2
exit 1
