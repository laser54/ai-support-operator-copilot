# Runtime environment. Copy to .env and adjust local values as needed.
ENVIRONMENT=local
LOG_LEVEL=INFO

# PostgreSQL connection used by the application and Alembic.
DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5432/copilot

# Comma-separated browser origins allowed to call this API. Keep empty to disable CORS.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public-demo cost control: per client IP, rolling window, before any LLM call.
INTAKE_RATE_LIMIT=10
INTAKE_RATE_WINDOW_SECONDS=3600

# Used only by integration tests; point it to a dedicated disposable database.
TEST_DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:55432/copilot_test

# Optional OpenAI-compatible endpoint. Docker Compose forwards these into the
# API container. Leave LLM_API_KEY empty only if you want the deterministic
# offline fallback; local demo should set a key so DeepSeek actually runs.
LLM_API_KEY=
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=deepseek-v4-flash
